{
  "name": "dsh-pocket-h5",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pocket H5 preview panel: preview and inspect H5 pages in the DSH Web UI at iPhone 17 size, appearance, and safe-area checks.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "ui",
    "vendor",
    "src",
    "build-client.mjs",
    "tests",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "build-info.json",
    "LICENSE",
    "tools",
    "tools/prepare-bezel.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "author": "Hazen223",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hazen223/dsh-pocket-h5-public.git"
  },
  "homepage": "https://github.com/Hazen223/dsh-pocket-h5-public#readme",
  "bugs": {
    "url": "https://github.com/Hazen223/dsh-pocket-h5-public/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "h5",
    "iphone",
    "preview",
    "qrcode",
    "panel"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build-client.mjs",
    "check": "node build-client.mjs && node --check client.js && node --check index.js",
    "test": "node tests/host-smoke.mjs && node tests/client-smoke.mjs",
    "release:check": "node build-client.mjs && node tests/host-smoke.mjs && node tests/client-smoke.mjs",
    "release": "node tools/release.mjs",
    "public:sync": "node tools/public-sync.mjs"
  }
}
